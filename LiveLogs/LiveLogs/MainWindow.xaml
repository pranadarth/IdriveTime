<Window
    x:Class="LiveLogs.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LiveLogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="Window_Loaded"
    Closing="Window_Closing"
    PreviewKeyDown="Window_PreviewKeyDown"
    AllowDrop="True"
    DragOver="LogTabControl_DragOver"
    Drop="LogTabControl_Drop"
    Title="Log Viewer"
    Width="1100" Height="650"
    MinHeight="450"
    MinWidth="750"
    UseLayoutRounding="True"
    FontFamily="Segoe UI, Segoe UI Symbol, Segoe UI Emoji"
    mc:Ignorable="d">
    <Window.Resources>

        <Style x:Key="ModernTabItemStyle" TargetType="{x:Type TabItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border"
                                Background="Transparent"
                                CornerRadius="6,6,0,0"
                                MaxWidth="280">
                            <Grid>
                            <Border x:Name="Indicator" Height="2" VerticalAlignment="Top" CornerRadius="6,6,0,0"
                                    Background="{DynamicResource AccentBrush}" Visibility="Hidden" />
                            <Grid Margin="12,7,6,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="HeaderText"
                                           Foreground="{DynamicResource PlaceholderForeground}"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{TemplateBinding Header}"
                                           ToolTip="{TemplateBinding ToolTip}"
                                           VerticalAlignment="Center" />
                                <Button Content="&#x2715;" Grid.Column="1"
                                        x:Name="CloseBtn" FontSize="10"
                                        Width="20" Height="20" Margin="8,0,0,0"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        Foreground="{DynamicResource PlaceholderForeground}"
                                        Click="Button_Click"
                                        ToolTip="Close tab"
                                        Tag="{Binding RelativeSource={RelativeSource AncestorType=TabItem}}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabHoverBackground}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource TabHoverBackground}" />
                                <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource PrimaryForeground}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource LogBackground}" />
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                                <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource PrimaryForeground}" />
                                <Setter TargetName="HeaderText" Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="CloseBtn" Property="Foreground" Value="{DynamicResource PrimaryForeground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTabControlStyle" TargetType="{x:Type TabControl}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <TabPanel IsItemsHost="True" HorizontalAlignment="Left" Margin="0" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Height="25" Width="42"
                                Background="{DynamicResource SecondaryBackground}"
                                BorderBrush="{DynamicResource BorderBrushColor}"
                                BorderThickness="1.5" CornerRadius="13">
                            <Border x:Name="CircleIndicator" CornerRadius="10" Height="20" Width="17"
                                    VerticalAlignment="Center" HorizontalAlignment="Left" Margin="3">
                                <TextBlock x:Name="CircleIndicatorText" Text="&#x1F506;" Foreground="Orange"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CircleIndicator" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="CircleIndicatorText" Property="Text" Value="&#x1F319;" />
                                <Setter TargetName="CircleIndicatorText" Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StyledTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="{DynamicResource PrimaryBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}" />
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryForeground}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource SubtleBorderBrush}"
                                    BorderThickness="1" CornerRadius="6" />
                            <ScrollViewer x:Name="PART_ContentHost" Margin="6,0,0,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="PlaceholderText" Margin="10,0,0,0"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                       Foreground="{DynamicResource PlaceholderForeground}"
                                       Text="{TemplateBinding Tag}" IsHitTestVisible="False"
                                       Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StyledButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="{DynamicResource ButtonHoverBackground}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource StyledButton}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2,0" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource PrimaryBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Top Bar  -->
        <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SubtleBorderBrush}"
                Background="{DynamicResource SecondaryBackground}">
        <Grid Height="50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Margin="6,0" VerticalAlignment="Center">
                <Button Content="&#x1F4C2; Open" Click="ChangeFile_Click" Style="{StaticResource StyledButton}"
                        ToolTip="Open log file(s) in new tab(s)  (Ctrl+O)" />
                <Button x:Name="OpenExternalBtn" Content="&#x2197; Open in editor" Click="OpenExternal_Click"
                        Style="{StaticResource StyledButton}"
                        ToolTip="Open the current file with its default application" />
                <Button x:Name="OpenFolderBtn" Content="&#x1F4C1;" Click="OpenFolder_Click"
                        Style="{StaticResource IconButton}"
                        ToolTip="Show the current file in Explorer" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                <TextBox Name="SearchTextBox" Width="260" Height="30"
                         Style="{StaticResource StyledTextBox}" Tag="Search &#x1F50D;  (Ctrl+F)"
                         TextChanged="SearchTextBox_TextChanged"
                         PreviewKeyDown="SearchTextBox_PreviewKeyDown" />
                <TextBlock x:Name="MatchCountText" Margin="8,0" MinWidth="50" VerticalAlignment="Center"
                           Foreground="{DynamicResource PlaceholderForeground}" />
                <Button x:Name="UpBtn" Content="&#x25B2;" Click="Button_Click_Up" Visibility="Collapsed"
                        Style="{StaticResource IconButton}" ToolTip="Previous match (Shift+Enter)" />
                <Button x:Name="DownBtn" Content="&#x25BC;" Click="Button_Click_Down" Visibility="Collapsed"
                        Style="{StaticResource IconButton}" ToolTip="Next match (Enter / F3)" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0" VerticalAlignment="Center">
                <Button x:Name="ClearLogsBtn" Content="&#x2718; Clear" Click="ClearLogsBtn_Click"
                        Style="{StaticResource StyledButton}"
                        ToolTip="Clear logs for current tab (file will be truncated)" />
                <ToggleButton x:Name="ThemeBtn" Margin="8,0,4,0" Click="ToggleTheme_Click"
                              ToolTip="Toggle theme"
                              Style="{StaticResource CustomToggleButtonStyle}" />
            </StackPanel>
        </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="8,6,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TabControl x:Name="LogTabControl"
                        Style="{StaticResource ModernTabControlStyle}"
                        SelectionChanged="LogTabControl_SelectionChanged" />
            <Border Grid.Row="1" BorderThickness="1" CornerRadius="0,6,6,6" Padding="0"
                    BorderBrush="{DynamicResource SubtleBorderBrush}"
                    Background="{DynamicResource LogBackground}">
                <!-- WebViews stay alive here; only visibility toggles on tab switch -->
                <Grid x:Name="ViewHost" />
            </Border>
        </Grid>

        <TextBlock x:Name="ct" Text="Open a file or Drag and Drop to view active logs" Grid.Row="1" FontSize="14"
                   Foreground="{DynamicResource PlaceholderForeground}" Visibility="Collapsed"
                   VerticalAlignment="Center" HorizontalAlignment="Center" />
    </Grid>
</Window>
