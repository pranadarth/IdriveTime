@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider
@inject Supabase.Client SupabaseClient
@using MudBlazor
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

<MudThemeProvider Theme="_currentTheme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<CascadingAuthenticationState>
    <AuthorizeView>
        <Authorized Context="authState">
            <MudLayout>
                <MudAppBar Elevation="0" Class="app-bar-glass">
                    <MudIconButton Icon="@Icons.Material.Rounded.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
                    <img src="ArthaOneLogo.png" alt="" style="height:28px;width:28px;border-radius:8px" class="ms-2" />
                    <MudText Typo="Typo.h6" Class="ms-2 fw-bold brand-text">ArthaOne</MudText>
                    <MudSpacer />

                    <MudToggleIconButton @bind-Toggled="@_isDarkMode"
                                         Icon="@Icons.Material.Filled.LightMode" Color="Color.Warning"
                                         ToggledIcon="@Icons.Material.Filled.DarkMode" ToggledColor="Color.Default"
                                         Title="Toggle Theme" Class="me-4" />

                    <MudTooltip Text="Go to Profile">
                        <MudIconButton DisableRipple="true" Class="pa-0" OnClick="@(() => Navigation.NavigateTo("/profile"))">
                            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" Style="font-weight: bold; border: 2px solid #e2e8f0;">
                                @GetUserInitial(authState)
                            </MudAvatar>
                        </MudIconButton>
                    </MudTooltip>
                </MudAppBar>

                <MudDrawer @bind-Open="_drawerOpen" Elevation="0" ClipMode="DrawerClipMode.Always" Variant="DrawerVariant.Responsive" Class="app-drawer">
                    <MudNavMenu Class="mt-4 px-2 modern-nav" Rounded="true" Margin="Margin.Dense" Color="Color.Primary">
                        <div class="nav-section">Overview</div>
                        <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Rounded.SpaceDashboard">Dashboard</MudNavLink>

                        <div class="nav-section">Money</div>
                        <MudNavLink Href="/transactions" Icon="@Icons.Material.Rounded.ReceiptLong">Transactions</MudNavLink>
                        <MudNavLink Href="/accounts" Icon="@Icons.Material.Rounded.AccountBalance">Accounts</MudNavLink>
                        <MudNavLink Href="/subscriptions" Icon="@Icons.Material.Rounded.Autorenew">Subscriptions</MudNavLink>
                        <MudNavLink Href="/expenses" Icon="@Icons.Material.Rounded.EventRepeat">Fixed Monthly Costs</MudNavLink>

                        <div class="nav-section">Wealth</div>
                        <MudNavLink Href="/investments" Icon="@Icons.Material.Rounded.ShowChart">Investments</MudNavLink>
                        <MudNavLink Href="/fire-goals" Icon="@Icons.Material.Rounded.LocalFireDepartment">FIRE Strategy</MudNavLink>

                        <div class="nav-section">Account</div>
                        <MudNavLink Href="/profile" Icon="@Icons.Material.Rounded.Settings">Profile & Settings</MudNavLink>
                    </MudNavMenu>
                </MudDrawer>

                <MudMainContent Style="min-height: 100vh;">
                    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pt-4 pb-8">
                        @Body
                    </MudContainer>
                </MudMainContent>
            </MudLayout>
        </Authorized>

        <NotAuthorized>
            <div class="d-flex justify-center align-center" style="height: 100vh;">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        </NotAuthorized>
    </AuthorizeView>
</CascadingAuthenticationState>

@code {
    bool _drawerOpen = true;

    // Defaulting to Dark Mode! No complex system checks needed.
    private bool _isDarkMode = true;

    void DrawerToggle() => _drawerOpen = !_drawerOpen;

    private string GetUserEmail(AuthenticationState context)
    {
        return context.User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Email)?.Value ?? "User";
    }

    private string GetUserInitial(AuthenticationState context)
    {
        var email = GetUserEmail(context);
        return string.IsNullOrEmpty(email) || email == "User" ? "U" : email[0].ToString().ToUpper();
    }

    // Custom Theme with Dark Mode Palette
    MudTheme _currentTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#4f46e5",
            Secondary = "#f59e0b",
            AppbarBackground = "#ffffff",
            AppbarText = "#1f2937",
            Background = "#f8fafc",
            Surface = "#ffffff",
            TextPrimary = "#111827",
            TextSecondary = "#4b5563",
            Success = "#10b981",
            Warning = "#f59e0b",
            Error = "#ef4444"
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#818cf8",
            Secondary = "#f59e0b",
            AppbarBackground = "#0b1120",
            AppbarText = "#f9fafb",
            Background = "#0b1120",
            Surface = "#111a2e",
            LinesDefault = "#1f2a44",
            TextPrimary = "#f9fafb",
            TextSecondary = "#94a3b8",
            Success = "#10b981",
            Warning = "#f59e0b",
            Error = "#ef4444",
            DrawerBackground = "#0b1120"
        },
        LayoutProperties = new LayoutProperties() { DefaultBorderRadius = "12px" },
        Typography = new Typography()
        {
            Default = new DefaultTypography() { FontFamily = new[] { "Inter", "Helvetica", "Arial", "sans-serif" } },
            Button = new ButtonTypography() { FontFamily = new[] { "Inter", "sans-serif" }, TextTransform = "none", FontWeight = "600" }
        }
    };

    protected override async Task OnInitializedAsync()
    {
        var uriString = Navigation.Uri;
        if (uriString.Contains("access_token") || uriString.Contains("code="))
        {
            try { await SupabaseClient.Auth.GetSessionFromUrl(Navigation.ToAbsoluteUri(uriString)); }
            catch { }
        }

        var authState = await AuthProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity == null || !authState.User.Identity.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
        }
    }
}