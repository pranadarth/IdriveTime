@page "/fire-goals"
@inject WealthEngine Engine
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

<PageTitle>FIRE Plan - ArthaOne</PageTitle>

<div class="page-wrap">
    <PageHeader Title="FIRE plan" Subtitle="Based on what you own today plus what you keep investing every month.">
        <Actions>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.Refresh" Class="btn-pill" OnClick="Reset">Reset to my data</MudButton>
        </Actions>
    </PageHeader>

    @if (S == null || P == null)
    {
        <LoadingSkeleton Cards="4" />
    }
    else
    {
        <div class="stat-grid mb-4">
            <StatCard Label="FIRE number (today's money)" Value="@Fmt.Compact(R?.TargetToday ?? 0)" Icon="@Icons.Material.Rounded.Flag" Tone="#f59e0b">
                <Sub>@Fmt.Inr(P.MonthlyExpense)/mo at @Fmt.Pct(P.Swr, 1) withdrawal</Sub>
            </StatCard>
            <StatCard Label="Invested today" Value="@Fmt.Compact(S.CoreNetWorth)" Icon="@Icons.Material.Rounded.Savings" Tone="#6366f1">
                <Sub>@Fmt.Pct(Math.Min(100, Fmt.Ratio(S.CoreNetWorth, R?.TargetToday ?? 0))) of target</Sub>
            </StatCard>
            <StatCard Label="Time to FIRE" Value="@(R?.Label ?? "-")" Icon="@Icons.Material.Rounded.HourglassBottom" Tone="#10b981">
                <Sub>@(R is { Reached: true } && Age.HasValue ? $"At age {Age.Value + (int)Math.Ceiling(R.YearsToFire)}" : "Add your date of birth in Profile")</Sub>
            </StatCard>
            <StatCard Label="Corpus needed then" Value="@Fmt.Compact(R?.TargetAtFire ?? 0)" Icon="@Icons.Material.Rounded.TrendingUp" Tone="#ef4444">
                <Sub>Inflation-adjusted</Sub>
            </StatCard>
        </div>

        <div class="two-col">
            <div class="col-side">
                <div class="panel">
                    <div class="panel-title">Assumptions</div>

                    <MudSwitch T="bool" Value="Essentials" ValueChanged="OnEssentials" Color="Color.Primary" Label="Lean FIRE (essential expenses only)" Class="mb-2" />

                    <div class="field-label">Monthly expenses in retirement</div>
                    <MudNumericField T="decimal" Value="P.MonthlyExpense" ValueChanged="@(v => Set(P with { MonthlyExpense = Math.Max(0, v) }))" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N0" Adornment="Adornment.Start" AdornmentText="@Fmt.Rupee" DebounceInterval="300" Class="mb-1" />
                    <div class="hint mb-3">From recurring expenses@(Essentials ? " marked essential" : ", subscriptions and your average variable spend").</div>

                    <div class="field-label">Monthly equity investment</div>
                    <MudNumericField T="decimal" Value="P.EquityMonthly" ValueChanged="@(v => Set(P with { EquityMonthly = Math.Max(0, v) }))" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N0" Adornment="Adornment.Start" AdornmentText="@Fmt.Rupee" DebounceInterval="300" Class="mb-3" />

                    <div class="field-label">Monthly debt / other investment</div>
                    <MudNumericField T="decimal" Value="P.DebtMonthly" ValueChanged="@(v => Set(P with { DebtMonthly = Math.Max(0, v) }))" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N0" Adornment="Adornment.Start" AdornmentText="@Fmt.Rupee" DebounceInterval="300" Class="mb-1" />
                    <div class="hint mb-3">EPF (@Fmt.Inr(S.EpfMonthly)/mo) and RDs (@Fmt.Inr(S.RdMonthly)/mo) are added automatically.</div>

                    <div class="d-flex gap-3">
                        <div class="flex-1">
                            <div class="field-label">Equity return %</div>
                            <MudNumericField T="double" Value="P.EquityReturn" ValueChanged="@(v => Set(P with { EquityReturn = Math.Clamp(v, 0, 30) }))" Variant="Variant.Outlined" Margin="Margin.Dense" Step="0.5" DebounceInterval="300" />
                        </div>
                        <div class="flex-1">
                            <div class="field-label">Debt return %</div>
                            <MudNumericField T="double" Value="P.DebtReturn" ValueChanged="@(v => Set(P with { DebtReturn = Math.Clamp(v, 0, 20) }))" Variant="Variant.Outlined" Margin="Margin.Dense" Step="0.5" DebounceInterval="300" />
                        </div>
                    </div>
                    <div class="d-flex gap-3 mt-3">
                        <div class="flex-1">
                            <div class="field-label">Inflation %</div>
                            <MudNumericField T="double" Value="P.Inflation" ValueChanged="@(v => Set(P with { Inflation = Math.Clamp(v, 0, 20) }))" Variant="Variant.Outlined" Margin="Margin.Dense" Step="0.5" DebounceInterval="300" />
                        </div>
                        <div class="flex-1">
                            <div class="field-label">Withdrawal rate %</div>
                            <MudNumericField T="double" Value="P.Swr" ValueChanged="@(v => Set(P with { Swr = Math.Clamp(v, 1, 10) }))" Variant="Variant.Outlined" Margin="Margin.Dense" Step="0.25" DebounceInterval="300" />
                        </div>
                    </div>
                    <div class="field-label mt-3">Yearly increase in investments (step-up) %</div>
                    <MudNumericField T="double" Value="P.AnnualStepUp" ValueChanged="@(v => Set(P with { AnnualStepUp = Math.Clamp(v, 0, 50) }))" Variant="Variant.Outlined" Margin="Margin.Dense" Step="1" DebounceInterval="300" />
                    <div class="hint mt-3">Changes here are a what-if only. To change your actual plan, edit items on the <a href="/recurring">Recurring</a> page.</div>
                </div>
            </div>

            <div class="col-main">
                <div class="panel">
                    <div class="panel-title">Year by year</div>
                    @if (R == null || R.TargetToday <= 0)
                    {
                        <EmptyState Icon="@Icons.Material.Rounded.LocalFireDepartment" Title="No expenses yet" Text="Add your monthly expenses on the Recurring page, or type an amount on the left." />
                    }
                    else
                    {
                        var max = R.Years.Max(y => Math.Max(y.Portfolio, y.Target));
                        <div class="fire-chart">
                            @foreach (var y in R.Years)
                            {
                                var hit = y.Portfolio >= y.Target;
                                <div class="fire-bar-wrap" title="Year @y.Year: @Fmt.Compact(y.Portfolio) vs target @Fmt.Compact(y.Target)">
                                    <div class="fire-target" style="bottom:@Fmt.Css(max > 0 ? (double)(y.Target / max * 100) : 0)%"></div>
                                    <div class="fire-bar @(hit ? "hit" : "")" style="height:@Fmt.Css(max > 0 ? (double)(y.Portfolio / max * 100) : 0)%"></div>
                                </div>
                            }
                        </div>
                        <div class="legend mt-2"><span><i class="dot" style="background:var(--mud-palette-primary)"></i>Portfolio</span><span><i class="dot" style="background:#10b981"></i>FIRE reached</span><span><i class="dot" style="background:#f59e0b"></i>Target</span></div>

                        <MudSimpleTable Dense="true" Hover="true" Class="mt-4" Style="max-height:420px;overflow:auto">
                            <thead><tr><th>Year</th><th>Age</th><th class="num">Portfolio</th><th class="num">Target</th><th class="num">You invested</th></tr></thead>
                            <tbody>
                                @foreach (var y in R.Years)
                                {
                                    <tr class="@(y.Portfolio >= y.Target ? "row-hit" : "")">
                                        <td>@(DateTime.Today.Year + y.Year)</td>
                                        <td>@(y.Age?.ToString() ?? "-")</td>
                                        <td class="num">@Fmt.Compact(y.Portfolio)</td>
                                        <td class="num">@Fmt.Compact(y.Target)</td>
                                        <td class="num">@Fmt.Compact(y.Invested)</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private FinanceSnapshot? S;
    private FireInputs? P;
    private FireResult? R;
    private int? Age;
    private bool Essentials;
    private int AgeMonths = 36;

    protected override async Task OnInitializedAsync()
    {
        S = await Engine.GetAsync();
        Age = WealthEngine.AgeOf(S.Settings);
        try { var a = await LocalStorage.GetItemAsync<int>("portfolioAge"); if (a > 0) AgeMonths = a; } catch { }
        Reset();
    }

    private void Reset()
    {
        if (S == null) return;
        Set(WealthEngine.DefaultInputs(S, AgeMonths, Essentials));
    }

    private void OnEssentials(bool v)
    {
        Essentials = v;
        if (S != null && P != null) Set(P with { MonthlyExpense = S.MonthlyCostOfLiving(v) });
    }

    private void Set(FireInputs p)
    {
        P = p;
        if (S != null) R = WealthEngine.Simulate(S, p, Age);
    }
}
