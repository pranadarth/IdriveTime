@page "/"
@inject WealthEngine Engine
@inject NavigationManager Nav
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@implements IDisposable

<PageTitle>Dashboard - ArthaOne</PageTitle>

<div class="page-wrap">
    <PageHeader Title="@Fmt.Greeting()" Subtitle="Here is where your money stands today.">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" Class="btn-pill" Href="/transactions">Add transaction</MudButton>
        </Actions>
    </PageHeader>

    @if (S == null)
    {
        <LoadingSkeleton Cards="4" />
    }
    else
    {
        var flow = S.MonthFlow(Fmt.ThisMonth);
        var left = flow.Income - flow.Spent - flow.Invested;
        var savingsRate = flow.Income > 0 ? Fmt.Ratio(flow.Invested, flow.Income) : 0;

        <div class="hero-card mb-4">
            <div>
                <div class="hero-label">Total net worth</div>
                <div class="hero-value">@Fmt.Inr(S.TotalNetWorth)</div>
                @if (Change is { } c && c.Diff != 0)
                {
                    <div class="hero-sub @(c.Diff >= 0 ? "pos" : "neg")">@Fmt.Signed(c.Diff) (@Fmt.Pct(c.Pct, 1)) since last update</div>
                }
            </div>
            <div class="hero-split">
                <div><span>Equity</span><b>@Fmt.Compact(S.EquityCore + S.ShortTermFunds)</b></div>
                <div><span>Debt</span><b>@Fmt.Compact(S.DebtTotal)</b></div>
                <div><span>Cash</span><b>@Fmt.Compact(S.CashInBank - S.CardDues)</b></div>
                <div><span>Other</span><b>@Fmt.Compact(S.Physical)</b></div>
            </div>
        </div>

        <div class="section-title">This month <span class="muted-text">@DateTime.Today.ToString("MMMM yyyy")</span></div>
        <div class="stat-grid mb-4">
            <StatCard Label="Income" Value="@Fmt.Inr(flow.Income)" Icon="@Icons.Material.Rounded.SouthWest" Tone="#10b981" OnClick="@(() => Nav.NavigateTo("/transactions"))" />
            <StatCard Label="Spent" Value="@Fmt.Inr(flow.Spent)" Icon="@Icons.Material.Rounded.NorthEast" Tone="#ef4444" OnClick="@(() => Nav.NavigateTo("/transactions"))" />
            <StatCard Label="Invested" Value="@Fmt.Inr(flow.Invested)" Icon="@Icons.Material.Rounded.TrendingUp" Tone="#6366f1" OnClick="@(() => Nav.NavigateTo("/recurring"))">
                <Sub>@Fmt.Pct(savingsRate) of income</Sub>
            </StatCard>
            <StatCard Label="Left to spend" Value="@Fmt.Inr(left)" Icon="@Icons.Material.Rounded.AccountBalanceWallet" Tone="#f59e0b" ValueColor="@(left < 0 ? "var(--mud-palette-error)" : null)" />
        </div>
        <div class="hint mb-6">Includes your recurring items (salary, rent, SIPs) automatically. Change them anytime on the <a href="/recurring">Recurring</a> page.</div>

        <div class="two-col">
            <div class="col-main">
                <div class="panel tone-violet mb-4">
                    <div class="panel-title d-flex justify-space-between align-center">
                        <span>Financial independence</span>
                        <MudButton Size="Size.Small" Variant="Variant.Text" Href="/fire-goals">Plan</MudButton>
                    </div>
                    @if (Fire == null || Fire.TargetToday <= 0)
                    {
                        <EmptyState Icon="@Icons.Material.Rounded.LocalFireDepartment" Title="Add your monthly expenses" Text="Add rent, food and other recurring costs so we can estimate your FIRE number.">
                            <MudButton Variant="Variant.Outlined" Href="/recurring" Class="btn-pill mt-2">Add recurring items</MudButton>
                        </EmptyState>
                    }
                    else
                    {
                        var progress = Math.Min(100, Fmt.Ratio(S.CoreNetWorth, Fire.TargetToday));
                        <div class="fire-row">
                            <div>
                                <div class="stat-label">FIRE number (today's money)</div>
                                <div class="stat-value">@Fmt.Compact(Fire.TargetToday)</div>
                            </div>
                            <div>
                                <div class="stat-label">Time to FIRE</div>
                                <div class="stat-value">@Fire.Label</div>
                            </div>
                            <div>
                                <div class="stat-label">FIRE age</div>
                                <div class="stat-value">@(Fire.Reached && Age.HasValue ? (Age.Value + (int)Math.Ceiling(Fire.YearsToFire)).ToString() : "-")</div>
                            </div>
                        </div>
                        <MudProgressLinear Color="Color.Primary" Value="@progress" Size="Size.Large" Rounded="true" Class="mt-4" />
                        <div class="row-sub mt-2">@Fmt.Pct(progress) of the way there @Fmt.Dot invests @Fmt.Inr(Inputs!.EquityMonthly + Inputs.DebtMonthly + S.EpfMonthly + S.RdMonthly)/mo @Fmt.Dot needs @Fmt.Inr(Inputs.MonthlyExpense)/mo</div>
                    }
                </div>

                <div class="panel tone-sky">
                    <div class="panel-title d-flex justify-space-between align-center">
                        <span>Accounts</span>
                        <MudButton Size="Size.Small" Variant="Variant.Text" Href="/accounts">Manage</MudButton>
                    </div>
                    @if (!S.Accounts.Any())
                    {
                        <div class="row-sub">No accounts yet. <a href="/accounts">Add your bank accounts</a> to track cash and card dues.</div>
                    }
                    else
                    {
                        @foreach (var a in S.Accounts.OrderBy(a => a.IsCredit).ThenByDescending(a => a.Balance).Take(6))
                        {
                            <div class="list-row">
                                <MudIcon Icon="@(a.IsCredit ? Icons.Material.Rounded.CreditCard : Icons.Material.Rounded.AccountBalance)" Size="Size.Small" />
                                <div class="flex-1 min-w-0">
                                    <div class="row-title ellipsis">@a.DisplayName</div>
                                    <div class="row-sub">@a.AccountType</div>
                                </div>
                                <div class="row-amount @(a.IsCredit ? "neg" : "")">@(a.IsCredit ? "-" : "")@Fmt.Inr(a.Balance)</div>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="col-side">
                <div class="panel tone-amber mb-4">
                    <div class="panel-title">Coming up (next 14 days)</div>
                    @{ var bills = S.UpcomingBills(14).Take(8).ToList(); }
                    @if (!bills.Any())
                    {
                        <div class="row-sub">Nothing due in the next two weeks.</div>
                    }
                    @foreach (var b in bills)
                    {
                        <div class="list-row">
                            <div class="date-chip"><b>@b.Date.Day</b><span>@b.Date.ToString("MMM")</span></div>
                            <div class="flex-1 min-w-0">
                                <div class="row-title ellipsis">@b.Name</div>
                                <div class="row-sub">@b.Kind</div>
                            </div>
                            <div class="row-amount @(b.Kind == TxnKinds.Investment ? "inv" : "")">@Fmt.Inr(b.Amount)</div>
                        </div>
                    }
                </div>

                <div class="panel tone-emerald">
                    <div class="panel-title">Monthly plan</div>
                    <div class="kv"><span>Recurring income</span><b class="pos">@Fmt.Inr(S.IncomeMonthly(Fmt.ThisMonth))</b></div>
                    <div class="kv"><span>Fixed expenses</span><b>@Fmt.Inr(S.RecurringMonthly(TxnKinds.Expense, Fmt.ThisMonth))</b></div>
                    <div class="kv"><span>Subscriptions</span><b>@Fmt.Inr(S.SubscriptionsMonthly)</b></div>
                    <div class="kv"><span>Avg. variable spend</span><b>@Fmt.Inr(S.VariableSpendAvg)</b></div>
                    <div class="kv"><span>Investments (incl. EPF/RD)</span><b class="inv">@Fmt.Inr(S.TotalInvestMonthly(Fmt.ThisMonth))</b></div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private FinanceSnapshot? S;
    private FireResult? Fire;
    private FireInputs? Inputs;
    private int? Age;
    private (decimal Diff, double Pct)? Change;
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            S = await Engine.GetAsync();
            Age = WealthEngine.AgeOf(S.Settings);
            int ageMonths = 36;
            try { var a = await LocalStorage.GetItemAsync<int>("portfolioAge"); if (a > 0) ageMonths = a; } catch { }
            Inputs = WealthEngine.DefaultInputs(S, ageMonths);
            Fire = WealthEngine.Simulate(S, Inputs, Age);
            StateHasChanged();
            if (!_cts.IsCancellationRequested)
                Change = await Engine.TrackNetWorthAsync(S.TotalNetWorth);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Dashboard load failed: {ex.Message}");
            S ??= new FinanceSnapshot();
        }
    }

    public void Dispose() => _cts.Cancel();
}
