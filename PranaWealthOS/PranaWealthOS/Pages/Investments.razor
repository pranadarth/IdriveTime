    private bool FilterStocks(StockHolding element) => string.IsNullOrWhiteSpace(searchStringStocks) || element.StockName.Contains(searchStringStocks, StringComparison.OrdinalIgnoreCase);
    private bool FilterMFs(MutualFundHolding element) => string.IsNullOrWhiteSpace(searchStringMFs) || element.SchemeName.Contains(searchStringMFs, StringComparison.OrdinalIgnoreCase);

    private string CleanName(string input) => string.IsNullOrWhiteSpace(input) ? "" : Regex.Replace(input.Replace('\u00A0', ' '), @"\s+", " ").Trim();

    private async Task HandleStockUpload(InputFileChangeEventArgs e)
    {
        using var stream = e.File.OpenReadStream();
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        ms.Position = 0;
        using var reader = ExcelReaderFactory.CreateReader(ms);
        var table = reader.AsDataSet().Tables[0];
        bool startReading = false;

        var newCloudStocks = new List<AssetModel>();

        foreach (DataRow row in table.Rows)
        {
            string firstCell = CleanName(row[0]?.ToString());
            if (firstCell == "Stock Name") { startReading = true; continue; }
            if (!startReading || string.IsNullOrWhiteSpace(firstCell) || firstCell == "null") continue;

            decimal closing = Convert.ToDecimal(row[6]);
            decimal invested = closing;
            try { invested = Convert.ToDecimal(row[5]); } catch { }

            newCloudStocks.Add(new AssetModel { UserId = CurrentUserId, AssetType = "Stock", Name = firstCell, InvestedValue = invested, CurrentValue = closing });
        }

        var newGrouped = newCloudStocks.GroupBy(s => s.Name, StringComparer.OrdinalIgnoreCase)
            .Select(g => new AssetModel { UserId = CurrentUserId, AssetType = "Stock", Name = g.Key, InvestedValue = g.Sum(s => s.InvestedValue), CurrentValue = g.Sum(s => s.CurrentValue) }).ToList();

        foreach (var stock in newGrouped)
        {
            var existing = Stocks.FirstOrDefault(e => e.StockName.Equals(stock.Name, StringComparison.OrdinalIgnoreCase));
            if (existing != null) { stock.Category = existing.Category; stock.IsShortTermGoal = existing.IsShortTermGoal; }
        }

        await SupabaseClient.From<AssetModel>().Where(x => x.UserId == CurrentUserId && x.AssetType == "Stock").Delete();
        await SupabaseClient.From<AssetModel>().Insert(newGrouped);

        await LoadAssetsFromCloud();
    }

