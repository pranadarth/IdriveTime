@page "/login"
@layout LoginLayout
@inject Supabase.Client SupabaseClient
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthProvider
@using MudBlazor
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>ArthaOne - Login</PageTitle>

<div class="d-flex align-center justify-center" style="min-height: 100vh; background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%); font-family: 'Inter', sans-serif;">
    <MudPaper Class="pa-10 text-center shadow-lg" Elevation="4" Style="width: 100%; max-width: 450px; border-radius: 20px;">

        <div class="mb-8">
            <h1 class="text-primary fw-bold m-0" style="font-size: 36px; letter-spacing: -1px;">ArthaOne</h1>
            <MudText Typo="Typo.caption" Class="text-muted fw-bold text-uppercase" Style="letter-spacing: 1.5px;">The Personal Wealth OS</MudText>
        </div>

        <MudText Typo="Typo.h5" Class="fw-bold mb-2 text-start text-dark">@(IsRegistering ? "Create your Account" : "Welcome Back")</MudText>
        <MudText Typo="Typo.body2" Class="text-muted text-start mb-6">@(IsRegistering ? "Get complete financial clarity across all your assets." : "Sign in to access your secure wealth dashboard.")</MudText>

        @if (IsRegistering)
        {
            <MudTextField @bind-Value="RegisterName" Label="Preferred Name" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Person" />
        }

        <MudTextField @bind-Value="Email" Label="Email Address" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" InputType="InputType.Email" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Email" UserAttributes="@(new Dictionary<string, object> { { "autocomplete", "username" } })" />

        <MudTextField @bind-Value="Password" Label="Password" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                      InputType="@PasswordInputType"
                      Adornment="Adornment.End"
                      AdornmentIcon="@PasswordInputIcon"
                      OnAdornmentClick="TogglePasswordVisibility" AdornmentAriaLabel="Show Password"
                      UserAttributes="@(new Dictionary<string, object> { { "autocomplete", "current-password" } })" />

        @if (IsRegistering)
        {
            <MudTextField @bind-Value="ConfirmPassword" Label="Confirm Password" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-5"
                          InputType="@PasswordInputType"
                          Adornment="Adornment.End"
                          AdornmentIcon="@PasswordInputIcon"
                          OnAdornmentClick="TogglePasswordVisibility" />
        }

        @if (!IsRegistering)
        {
            <div class="d-flex justify-end mb-5">
                <MudLink OnClick="HandleForgotPassword" Typo="Typo.caption" Class="fw-bold text-primary" Style="cursor: pointer; text-decoration: none;">
                    Forgot Password?
                </MudLink>
            </div>
        }

        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth Size="Size.Large" OnClick="HandleAuth" Disabled="IsLoading" Style="border-radius: 10px; text-transform: none; font-size: 16px; font-weight: 600; padding: 12px 0;">
            @if (IsLoading)
            {
                <MudProgressCircular Color="Color.Inherit" Size="Size.Small" Indeterminate="true" Class="me-3" />
                <span>Processing...</span>
            }
            else
            {
                <span>@(IsRegistering ? "Sign Up" : "Sign In")</span>
            }
        </MudButton>

        <div class="d-flex align-center my-5">
            <div style="flex-grow: 1; height: 1px; background-color: #cbd5e1;"></div>
            <MudText Typo="Typo.caption" Class="mx-4 text-muted fw-bold">OR</MudText>
            <div style="flex-grow: 1; height: 1px; background-color: #cbd5e1;"></div>
        </div>

        <MudButton Variant="Variant.Outlined" FullWidth Size="Size.Large" OnClick="HandleGoogleLogin" Style="border-radius: 10px; text-transform: none; font-size: 16px; font-weight: 600; padding: 10px 0; border-color: #cbd5e1; color: #334155;">
            <svg class="me-3" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4" />
                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" />
                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05" />
                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335" />
            </svg>
            Continue with Google
        </MudButton>

        <div class="mt-6">
            <MudText Typo="Typo.body2" Class="text-muted">
                @(IsRegistering ? "Already have an account?" : "New to ArthaOne?")
                <MudLink OnClick="ToggleMode" Class="fw-bold text-primary ms-1" Style="cursor: pointer; text-decoration: none;">
                    @(IsRegistering ? "Sign In" : "Create Account")
                </MudLink>
            </MudText>
        </div>

    </MudPaper>
</div>

@code {
    private string Email { get; set; } = "";
    private string Password { get; set; } = "";
    private string ConfirmPassword { get; set; } = "";
    private string RegisterName { get; set; } = "";
    private bool IsRegistering { get; set; } = false;
    private bool IsLoading { get; set; } = false;

    private bool isShow;
    private InputType PasswordInputType = InputType.Password;
    private string PasswordInputIcon = Icons.Material.Filled.VisibilityOff;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity != null && authState.User.Identity.IsAuthenticated)
        {
            Navigation.NavigateTo("/");
        }
    }

    private void TogglePasswordVisibility()
    {
        if (isShow) { isShow = false; PasswordInputIcon = Icons.Material.Filled.VisibilityOff; PasswordInputType = InputType.Password; }
        else { isShow = true; PasswordInputIcon = Icons.Material.Filled.Visibility; PasswordInputType = InputType.Text; }
    }

    private void ToggleMode()
    {
        IsRegistering = !IsRegistering;
        Email = ""; Password = ""; ConfirmPassword = ""; RegisterName = ""; isShow = false;
        PasswordInputType = InputType.Password; PasswordInputIcon = Icons.Material.Filled.VisibilityOff;
    }

    private bool IsValidEmail(string email)
    {
        try { var addr = new System.Net.Mail.MailAddress(email); return addr.Address == email; }
        catch { return false; }
    }

    private async Task HandleForgotPassword()
    {
        if (string.IsNullOrWhiteSpace(Email) || !IsValidEmail(Email))
        {
            Snackbar.Add("Please enter your valid email address above first.", Severity.Warning);
            return;
        }

        IsLoading = true; StateHasChanged();
        try
        {
            await SupabaseClient.Auth.ResetPasswordForEmail(Email);
            Snackbar.Add("If an account exists, a reset link has been sent.", Severity.Info);
        }
        catch (Exception) { Snackbar.Add("Unable to send reset email. Please try again.", Severity.Error); }
        finally { IsLoading = false; StateHasChanged(); }
    }

    private async Task HandleGoogleLogin()
    {
        try
        {
            var authState = await SupabaseClient.Auth.SignIn(Supabase.Gotrue.Constants.Provider.Google);
            if (authState != null && authState.Uri != null) Navigation.NavigateTo(authState.Uri.ToString(), forceLoad: true);
        }
        catch (Exception) { Snackbar.Add("Failed to initialize Google Login.", Severity.Error); }
    }

    private async Task HandleAuth()
    {
        if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Password)) { Snackbar.Add("Please enter both email and password.", Severity.Warning); return; }
        if (!IsValidEmail(Email)) { Snackbar.Add("Please enter a valid email format.", Severity.Warning); return; }

        if (IsRegistering)
        {
            if (string.IsNullOrWhiteSpace(RegisterName)) { Snackbar.Add("Please enter your name.", Severity.Warning); return; }
            if (Password.Length < 6) { Snackbar.Add("Password must be at least 6 characters long.", Severity.Warning); return; }
            if (Password != ConfirmPassword) { Snackbar.Add("Passwords do not match.", Severity.Error); return; }
        }

        IsLoading = true; StateHasChanged();

        try
        {
            if (IsRegistering)
            {
                var options = new Supabase.Gotrue.SignUpOptions { Data = new Dictionary<string, object> { { "name", RegisterName } } };
                var session = await SupabaseClient.Auth.SignUp(Email, Password, options);

                if (session?.User?.Identities == null || !session.User.Identities.Any())
                {
                    Snackbar.Add("This email is already registered. Try signing in!", Severity.Warning);
                }
                else
                {
                    Snackbar.Add("Registration successful! Check your email.", Severity.Success);
                    ToggleMode(); // Switch back to login view
                }
            }
            else
            {
                var session = await SupabaseClient.Auth.SignIn(Email, Password);
                if (session != null)
                {
                    Snackbar.Add("Welcome back to ArthaOne!", Severity.Success);
                    Navigation.NavigateTo("/");
                }
            }
        }
        catch (Exception ex)
        {
            string msg = "An error occurred.";
            if (ex.Message.Contains("Invalid login credentials")) msg = "Invalid email or password.";
            else if (ex.Message.Contains("already registered")) msg = "This email is already registered.";
            else if (ex.Message.Contains("Email not confirmed")) msg = "Please verify your email address first.";

            Snackbar.Add(msg, Severity.Error);
        }
        finally
        {
            IsLoading = false; StateHasChanged();
        }
    }
}