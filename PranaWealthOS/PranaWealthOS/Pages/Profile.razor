@page "/profile"
@inject Supabase.Client SupabaseClient
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider
@inject WealthEngine Engine
@inject ISnackbar Snackbar
@using System.Security.Claims

<PageTitle>Profile - ArthaOne</PageTitle>

<div class="page-wrap" style="max-width:1000px">
    <PageHeader Title="Profile & Settings" Subtitle="Your details and the assumptions used for every projection." />

    @if (Loading)
    {
        <LoadingSkeleton Cards="2" />
    }
    else
    {
        <div class="glass-hero mb-5">
            <div class="d-flex align-center gap-4 flex-1 min-w-0">
                <div class="avatar-xl">@Initial</div>
                <div class="min-w-0">
                    <div class="hero-name ellipsis">@(string.IsNullOrWhiteSpace(Settings.UserName) ? "Welcome" : Settings.UserName)</div>
                    <div class="hero-mail ellipsis">@Email</div>
                    <span class="glass-chip mt-2"><MudIcon Icon="@Icons.Material.Rounded.VerifiedUser" Size="Size.Small" /> Cloud synced</span>
                </div>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <MudButton Variant="Variant.Outlined" Class="btn-glass" StartIcon="@Icons.Material.Rounded.Logout" OnClick="HandleLogout">Sign out</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Save" OnClick="SaveSettings" Disabled="Saving" Class="btn-pill">@(Saving ? "Saving..." : "Save changes")</MudButton>
            </div>
        </div>

        <div class="grid-2">
            <div class="panel tone-indigo">
                <div class="panel-title"><span class="title-icon"><MudIcon Icon="@Icons.Material.Rounded.Person" Size="Size.Small" /></span>Personal</div>
                <MudTextField @bind-Value="Settings.UserName" Label="Preferred name" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" />
                <MudDatePicker Label="Date of birth" @bind-Date="Settings.DateOfBirth" Variant="Variant.Outlined" Margin="Margin.Dense" HelperText="Used to show your FIRE age." />
                <div class="info-box mt-5">
                    <MudIcon Icon="@Icons.Material.Rounded.EventRepeat" Size="Size.Small" />
                    <div>Monthly income, SIPs and fixed costs now live in <a href="/recurring">Income &amp; Expenses &rsaquo; Recurring</a>, so you can change them from any month.</div>
                </div>
            </div>

            <div class="panel tone-amber">
                <div class="panel-title"><span class="title-icon"><MudIcon Icon="@Icons.Material.Rounded.LocalFireDepartment" Size="Size.Small" /></span>FIRE assumptions</div>
                <MudNumericField @bind-Value="Settings.ExpectedInflation" Label="Expected inflation (%)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Step="0.5" />
                <MudNumericField @bind-Value="Settings.ExpectedEquityReturn" Label="Fallback equity return (%)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" Step="0.5" HelperText="Used until your portfolio is 3 years old." />
                <MudSelect T="double" @bind-Value="Settings.SafeWithdrawalRate" Label="Safe withdrawal rate" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem T="double" Value="4.0">4.0% (standard, 25x expenses)</MudSelectItem>
                    <MudSelectItem T="double" Value="3.5">3.5% (conservative, 28x)</MudSelectItem>
                    <MudSelectItem T="double" Value="3.0">3.0% (very safe, 33x)</MudSelectItem>
                    <MudSelectItem T="double" Value="2.5">2.5% (generational, 40x)</MudSelectItem>
                </MudSelect>
            </div>
        </div>

        <div class="app-foot">
            <b>ArthaOne</b> @Fmt.Dot v2.0
            @Fmt.Dot <a href="mailto:projectarthaone@gmail.com?subject=ArthaOne%20Support">Contact support</a>
            @Fmt.Dot &copy; @DateTime.Now.Year
        </div>
    }
</div>

@code {
    private string Email = "";
    private string Initial = "U";
    private string currentUserId = "";
    private bool Loading = true, Saving;
    private UserSettings Settings = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = (await AuthProvider.GetAuthenticationStateAsync()).User;
            if (user.Identity?.IsAuthenticated != true) return;

            currentUserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? SupabaseClient.Auth.CurrentUser?.Id ?? "";
            Email = user.FindFirst(ClaimTypes.Email)?.Value ?? SupabaseClient.Auth.CurrentUser?.Email ?? "";

            var snap = await Engine.GetAsync();
            Settings = snap.Settings.Id == currentUserId ? snap.Settings : new UserSettings { Id = currentUserId };

            if (string.IsNullOrWhiteSpace(Settings.UserName)
                && SupabaseClient.Auth.CurrentUser?.UserMetadata is { } meta
                && meta.TryGetValue("name", out var n) && n != null)
            {
                Settings.UserName = n.ToString() ?? "";
            }

            var src = !string.IsNullOrWhiteSpace(Settings.UserName) ? Settings.UserName : Email;
            Initial = string.IsNullOrEmpty(src) ? "U" : char.ToUpperInvariant(src[0]).ToString();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not load profile: {ex.Message}", Severity.Error);
        }
        finally
        {
            Loading = false;
        }
    }

    private async Task SaveSettings()
    {
        if (string.IsNullOrEmpty(currentUserId)) return;
        Saving = true;
        try
        {
            Settings.Id = currentUserId;
            await SupabaseClient.From<UserSettings>().Upsert(Settings);
            Engine.Invalidate();
            Snackbar.Add("Settings saved", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to save: {ex.Message}", Severity.Error);
        }
        finally { Saving = false; }
    }

    private async Task HandleLogout()
    {
        Engine.Invalidate();
        await SupabaseClient.Auth.SignOut();
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
