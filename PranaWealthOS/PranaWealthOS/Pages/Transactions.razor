@page "/transactions"
@inject WealthEngine Engine
@inject Supabase.Client Db
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@using static Postgrest.Constants

<PageTitle>Transactions | ArthaOne</PageTitle>

<div class="page-wrap">
    <MoneyTabs Subtitle="Every rupee in and out. Recurring items (salary, rent, SIPs) fill in automatically each month.">
        <Actions>
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Rounded.UploadFile" OnClick="@(() => ImportOpen = true)">Import</MudButton>
            <MudMenu Icon="@Icons.Material.Rounded.Download" AriaLabel="Export">
                <MudMenuItem OnClick="@(() => Export(false))">Export @Month.ToString("MMM yyyy") (CSV)</MudMenuItem>
                <MudMenuItem OnClick="@(() => Export(true))">Export last 12 months (CSV)</MudMenuItem>
            </MudMenu>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" OnClick="@(() => OpenNew(TxnKinds.Expense))" Class="btn-pill d-none d-sm-flex">Add</MudButton>
        </Actions>
    </MoneyTabs>

    <div class="month-nav mb-4">
        <MudIconButton Icon="@Icons.Material.Rounded.ChevronLeft" OnClick="@(() => ChangeMonth(-1))" Disabled="@(Month <= Fmt.ThisMonth.AddMonths(-12))" AriaLabel="Previous month" />
        <div class="month-label">@Month.ToString("MMMM yyyy")</div>
        <MudIconButton Icon="@Icons.Material.Rounded.ChevronRight" OnClick="@(() => ChangeMonth(1))" Disabled="@(Month >= Fmt.ThisMonth)" AriaLabel="Next month" />
        @if (Month != Fmt.ThisMonth)
        {
            <MudButton Size="Size.Small" OnClick="@(() => Month = Fmt.ThisMonth)">This month</MudButton>
        }
    </div>

    @if (Loading)
    {
        <LoadingSkeleton />
    }
    else
    {
        var spent = Spent; var prev = PrevSpent;
        <div class="stat-grid mb-5">
            <StatCard Label="Spent" Value="@Fmt.Inr(spent)" Icon="@Icons.Material.Rounded.NorthEast" Tone="#ef4444">
                <Sub>
                    @if (prev > 0)
                    {
                        var d = Fmt.Ratio(spent - prev, prev);
                        <span class="@(d > 0 ? "neg" : "pos")">@(d > 0 ? "Up" : "Down") @Fmt.Pct(Math.Abs(d)) vs last month</span>
                    }
                    else { <span>@MonthItems.Count(t => t.IsSpend) expenses</span> }
                </Sub>
            </StatCard>
            <StatCard Label="Income" Value="@Fmt.Inr(Earned)" Icon="@Icons.Material.Rounded.SouthWest" Tone="#10b981" />
            <StatCard Label="Invested" Value="@Fmt.Inr(Invested)" Icon="@Icons.Material.Rounded.TrendingUp" Tone="#6366f1">
                <Sub>@(Earned > 0 ? $"Savings rate {Fmt.Pct(Fmt.Ratio(Earned - spent, Earned))}" : "SIPs, NPS, PPF...")</Sub>
            </StatCard>
            <StatCard Label="Left this month" Value="@Fmt.Inr(Earned - spent - Invested)" Icon="@Icons.Material.Rounded.Wallet" Tone="#f59e0b"
                      ValueColor="@(Earned - spent - Invested < 0 ? "var(--mud-palette-error)" : null)">
                <Sub>
                    @if (Month == Fmt.ThisMonth && Upcoming.Any())
                    {
                        <span>@Fmt.Inr(Upcoming.Where(t => !t.IsIncome).Sum(t => t.Amount)) still due</span>
                    }
                    else { <span>Avg @Fmt.Inr(DailyAvg)/day</span> }
                </Sub>
            </StatCard>
        </div>

        <div class="two-col">
            <div class="col-main">
                <div class="panel">
                    <div class="toolbar mb-3">
                        <MudTextField @bind-Value="Search" Placeholder="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Rounded.Search"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" DebounceInterval="250" Clearable="true" Class="flex-1" />
                        <div class="seg seg-sm">
                            @foreach (var f in new[] { "All", TxnKinds.Expense, TxnKinds.Income, TxnKinds.Investment })
                            {
                                <button class="seg-btn @(FilterType == f ? "active" : "")" @onclick="@(() => FilterType = f)">@(f switch { "Expense" => "Spent", "Income" => "Income", "Investment" => "Invested", _ => "All" })</button>
                            }
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(FilterCategory))
                    {
                        <MudChip T="string" OnClose="@(() => FilterCategory = null)" Size="Size.Small" Color="Color.Primary" Class="mb-2">@FilterCategory</MudChip>
                    }

                    @if (Month == Fmt.ThisMonth && Upcoming.Any() && FilterType == "All" && string.IsNullOrEmpty(Search))
                    {
                        <div class="day-header"><span>Upcoming this month</span><span>@Fmt.Inr(Upcoming.Sum(t => t.IsIncome ? 0 : t.Amount))</span></div>
                        @foreach (var t in Upcoming)
                        {
                            @Row(t, true)
                        }
                    }

                    @{ var list = Filtered.ToList(); }
                    @if (!list.Any())
                    {
                        <EmptyState Icon="@Icons.Material.Rounded.ReceiptLong" Title="Nothing here yet" Text="Add an expense, import your bank statement, or set up recurring items like rent and salary.">
                            <div class="d-flex gap-2 justify-center flex-wrap mt-2">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => OpenNew(TxnKinds.Expense))" Class="btn-pill">Add expense</MudButton>
                                <MudButton Variant="Variant.Outlined" OnClick="@(() => ImportOpen = true)" Class="btn-pill">Import statement</MudButton>
                                <MudButton Variant="Variant.Text" Href="/recurring">Set up recurring</MudButton>
                            </div>
                        </EmptyState>
                    }
                    else
                    {
                        @foreach (var day in list.GroupBy(t => t.TxnDate.Date).OrderByDescending(g => g.Key))
                        {
                            var dOut = day.Where(t => t.IsSpend).Sum(t => t.Amount);
                            var dIn = day.Where(t => t.IsIncome).Sum(t => t.Amount);
                            <div class="day-header">
                                <span>@DayLabel(day.Key)</span>
                                <span>
                                    @if (dOut > 0) { <span>-@Fmt.Inr(dOut)</span> }
                                    @if (dIn > 0) { <span class="pos ms-2">+@Fmt.Inr(dIn)</span> }
                                </span>
                            </div>
                            @foreach (var t in day)
                            {
                                @Row(t, false)
                            }
                        }
                    }
                </div>
            </div>

            <div class="col-side">
                <div class="panel">
                    <div class="panel-title">Where it went</div>
                    @{ var cats = ByCategory; }
                    @if (spent == 0)
                    {
                        <div class="muted-text">No spending yet this month.</div>
                    }
                    else
                    {
                        <div class="stack-bar mb-3">
                            @foreach (var g in cats)
                            {
                                <div title="@g.Name" style="width:@Fmt.Css(Fmt.Ratio(g.Total, spent))%;background:@Categories.Get(g.Name).Color"></div>
                            }
                        </div>
                        @foreach (var g in cats.Take(7))
                        {
                            var info = Categories.Get(g.Name);
                            <div class="cat-line" @onclick="@(() => { FilterCategory = g.Name; FilterType = "All"; })">
                                <span class="dot" style="background:@info.Color"></span>
                                <span class="flex-1">@g.Name</span>
                                <span class="muted-text">@Fmt.Pct(Fmt.Ratio(g.Total, spent))</span>
                                <b class="num">@Fmt.Inr(g.Total)</b>
                            </div>
                        }
                    }
                </div>

                <div class="panel">
                    <div class="d-flex justify-space-between align-center mb-2">
                        <div class="panel-title m-0">Budgets</div>
                        <MudButton Size="Size.Small" StartIcon="@Icons.Material.Rounded.Add" OnClick="OpenBudget">Set</MudButton>
                    </div>
                    @if (!Budgets.Any())
                    {
                        <div class="muted-text">Set monthly limits per category and get a heads-up before you overspend.</div>
                    }
                    else
                    {
                        @foreach (var b in Budgets.OrderByDescending(b => SpentIn(b.Category) / Math.Max(b.MonthlyLimit, 1)))
                        {
                            var used = SpentIn(b.Category);
                            var pct = Fmt.Ratio(used, b.MonthlyLimit);
                            var color = pct >= 100 ? Color.Error : pct >= 80 ? Color.Warning : Color.Success;
                            var info = Categories.Get(b.Category);
                            <div class="budget-row">
                                <div class="d-flex justify-space-between align-center">
                                    <span class="d-flex align-center gap-1 fw-600"><MudIcon Icon="@info.Icon" Size="Size.Small" Style="@($"color:{info.Color}")" />@b.Category</span>
                                    <span class="d-flex align-center">
                                        <span class="small">@Fmt.Inr(used) / @Fmt.Inr(b.MonthlyLimit)</span>
                                        <MudIconButton Icon="@Icons.Material.Rounded.Close" Size="Size.Small" OnClick="@(() => DeleteBudget(b))" AriaLabel="Remove budget" />
                                    </span>
                                </div>
                                <MudProgressLinear Value="@Math.Min(pct, 100)" Color="@color" Rounded="true" />
                                <div class="small muted-text mt-1">
                                    @if (pct >= 100) { <span class="neg">Over by @Fmt.Inr(used - b.MonthlyLimit)</span> }
                                    else if (Month == Fmt.ThisMonth)
                                    {
                                        var daysLeft = DateTime.DaysInMonth(Month.Year, Month.Month) - DateTime.Today.Day + 1;
                                        <span>@Fmt.Inr((b.MonthlyLimit - used) / daysLeft)/day for @daysLeft days</span>
                                    }
                                    else { <span>@Fmt.Pct(pct) used</span> }
                                </div>
                            </div>
                        }
                    }
                </div>

                <div class="panel">
                    <div class="panel-title">6-month trend</div>
                    @{ var trend = Trend(); var max = Math.Max(1m, trend.Max(x => Math.Max(x.Spent, x.Earned))); }
                    <div class="trend-chart">
                        @foreach (var m in trend)
                        {
                            <div class="trend-col @(m.Month == Month ? "active" : "")" @onclick="@(() => Month = m.Month)" title="@($"{m.Month:MMM yyyy}: spent {Fmt.Inr(m.Spent)}, income {Fmt.Inr(m.Earned)}")">
                                <div class="trend-bars">
                                    <div class="bar in" style="height:@Fmt.Css(Fmt.Ratio(m.Earned, max))%"></div>
                                    <div class="bar out" style="height:@Fmt.Css(Fmt.Ratio(m.Spent, max))%"></div>
                                </div>
                                <div class="trend-label">@m.Month.ToString("MMM")</div>
                            </div>
                        }
                    </div>
                    <div class="legend"><span><i class="dot" style="background:#10b981"></i>Income</span><span><i class="dot" style="background:#ef4444"></i>Spent</span></div>
                </div>

                @{ var insights = Insights(); }
                @if (insights.Any())
                {
                    <div class="panel">
                        <div class="panel-title d-flex align-center gap-1"><MudIcon Icon="@Icons.Material.Rounded.AutoAwesome" Size="Size.Small" Color="Color.Warning" />Insights</div>
                        @foreach (var i in insights)
                        {
                            <div class="insight">@i</div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

<MudFab Class="fab-add d-sm-none" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" OnClick="@(() => OpenNew(TxnKinds.Expense))" />

<!-- ADD / EDIT -->
<MudDialog @bind-Visible="EditOpen" Options="DialogSmall">
    <TitleContent><div class="dialog-title">@DialogTitle</div></TitleContent>
    <DialogContent>
        @if (Editing.RecurringId == null)
        {
            <div class="seg mb-4">
                @foreach (var k in TxnKinds.All)
                {
                    <button class="seg-btn @(Editing.TxnType == k ? "active" : "")" @onclick="@(() => SetType(k))">@(k == TxnKinds.Investment ? "Invest" : k)</button>
                }
            </div>
        }
        else
        {
            <div class="hint mb-3"><MudIcon Icon="@Icons.Material.Rounded.Autorenew" Size="Size.Small" />Recurring item. Changes here apply to @Editing.TxnDate.ToString("MMMM") only.</div>
        }

        <MudNumericField @bind-Value="Editing.Amount" Label="Amount" Adornment="Adornment.Start" AdornmentText="@Fmt.Rupee" Format="N0" HideSpinButtons="true" Variant="Variant.Outlined" Class="mb-3 amount-input" AutoFocus="@(Editing.Id == null && Editing.RecurringId == null)" />
        <MudTextField @bind-Value="Editing.Description" Label="Description" Placeholder="@(Editing.IsIncome ? "e.g. Salary" : Editing.IsInvestment ? "e.g. Nifty 50 SIP" : "e.g. Swiggy dinner")"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Immediate="true" OnBlur="AutoCat" />

        <div class="field-label">Category</div>
        <div class="cat-grid mb-3">
            @foreach (var c in Categories.For(Editing.TxnType))
            {
                <div class="cat-pill @(Editing.Category == c.Name ? "selected" : "")" style="--c:@c.Color" @onclick="@(() => Editing.Category = c.Name)">
                    <MudIcon Icon="@c.Icon" Size="Size.Small" /><span>@c.Name</span>
                </div>
            }
        </div>

        <div class="d-flex gap-3">
            <MudDatePicker @bind-Date="EditDate" Label="Date" Variant="Variant.Outlined" Margin="Margin.Dense" MaxDate="DateTime.Today.AddMonths(1)" Class="flex-1" />
            <MudSelect T="string" @bind-Value="Editing.PaymentMode" Label="Paid via" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-1">
                @foreach (var p in Categories.PaymentModes) { <MudSelectItem Value="@p">@p</MudSelectItem> }
            </MudSelect>
        </div>
        @if (Snap!.Accounts.Any())
        {
            <MudSelect T="string" @bind-Value="Editing.AccountId" Label="Account" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3">
                @foreach (var a in Snap.Accounts) { <MudSelectItem Value="@a.Id">@a.DisplayName</MudSelectItem> }
            </MudSelect>
        }
        <MudTextField @bind-Value="Editing.Notes" Label="Note (optional)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3" />

        @if (Editing.Id == null && Editing.RecurringId == null)
        {
            <MudCheckBox @bind-Value="MakeRecurring" Color="Color.Primary" Class="mt-2" Dense="true">
                Repeats every month (rent, salary, SIP...)
            </MudCheckBox>
        }
    </DialogContent>
    <DialogActions>
        @if (Editing.Id != null)
        {
            <MudButton Color="Color.Error" OnClick="DeleteEditing" Class="me-auto">Delete</MudButton>
        }
        else if (Editing.RecurringId != null)
        {
            <MudButton Color="Color.Error" OnClick="SkipRecurring" Class="me-auto">Skip this month</MudButton>
        }
        <MudButton OnClick="@(() => EditOpen = false)">Cancel</MudButton>
        @if (Editing.Id == null && Editing.RecurringId == null && !MakeRecurring)
        {
            <MudButton Variant="Variant.Outlined" OnClick="@(() => Save(true))" Disabled="Busy" Class="d-none d-sm-flex">Save &amp; add another</MudButton>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Save(false))" Disabled="Busy">@(Busy ? "Saving..." : "Save")</MudButton>
    </DialogActions>
</MudDialog>

<!-- IMPORT -->
<MudDialog @bind-Visible="ImportOpen" Options="DialogLarge">
    <TitleContent><div class="dialog-title">Import bank or card statement</div></TitleContent>
    <DialogContent>
        @if (!ImportPreview.Any())
        {
            <p class="muted-text mb-3">
                Download your statement from net banking as CSV, XLS or XLSX. We detect the date, description and debit/credit columns automatically
                (HDFC, ICICI, SBI, Axis, Kotak and most credit cards) and categorise each row. Nothing is saved until you confirm.
            </p>
            @if (Snap?.Accounts.Any() == true)
            {
                <MudSelect T="string" @bind-Value="ImportAccountId" Label="Statement account (optional)" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
                    @foreach (var a in Snap.Accounts) { <MudSelectItem Value="@a.Id">@a.DisplayName</MudSelectItem> }
                </MudSelect>
            }
            <label class="drop-zone">
                <MudIcon Icon="@Icons.Material.Rounded.CloudUpload" Size="Size.Large" Color="Color.Primary" />
                <div class="fw-600 mt-2">Click to choose a file</div>
                <div class="small muted-text">.csv, .xls, .xlsx up to 10 MB</div>
                <InputFile OnChange="HandleImport" accept=".csv,.xls,.xlsx" class="drop-input" />
            </label>
            @if (Parsing) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-3" /> }
        }
        else
        {
            var inc = ImportPreview.Where(r => r.Include).ToList();
            <div class="d-flex flex-wrap justify-space-between align-center mb-3 gap-2">
                <div class="small">
                    <b>@ImportPreview.Count</b> rows found. Selected: <b>@inc.Count</b>
                    <span class="neg ms-2">-@Fmt.Inr(inc.Where(r => !r.Txn.IsIncome).Sum(r => r.Txn.Amount))</span>
                    <span class="pos ms-2">+@Fmt.Inr(inc.Where(r => r.Txn.IsIncome).Sum(r => r.Txn.Amount))</span>
                    @if (ImportPreview.Any(r => r.Duplicate)) { <span class="warn ms-2">@ImportPreview.Count(r => r.Duplicate) already imported</span> }
                </div>
                <MudButton Size="Size.Small" OnClick="@(() => ImportPreview.Clear())" StartIcon="@Icons.Material.Rounded.ArrowBack">Another file</MudButton>
            </div>
            <MudTable Items="ImportPreview" Dense="true" Hover="true" FixedHeader="true" Height="52vh" Elevation="0" Virtualize="true">
                <HeaderContent>
                    <MudTh Style="width:40px"></MudTh>
                    <MudTh>Date</MudTh>
                    <MudTh>Description</MudTh>
                    <MudTh Style="width:130px">Type</MudTh>
                    <MudTh Style="width:180px">Category</MudTh>
                    <MudTh Style="text-align:right">Amount</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd><MudCheckBox @bind-Value="context.Include" Size="Size.Small" Dense="true" /></MudTd>
                    <MudTd Class="nowrap">@context.Txn.TxnDate.ToString("dd MMM")</MudTd>
                    <MudTd><div class="ellipsis" style="max-width:340px" title="@context.Txn.Description">@context.Txn.Description</div></MudTd>
                    <MudTd>
                        <MudSelect T="string" Value="context.Txn.TxnType" ValueChanged="@(v => { context.Txn.TxnType = v; context.Txn.Category = Categories.DefaultFor(v); })" Dense="true" Margin="Margin.Dense" Underline="false">
                            @foreach (var k in TxnKinds.All) { <MudSelectItem Value="@k">@k</MudSelectItem> }
                        </MudSelect>
                    </MudTd>
                    <MudTd>
                        <MudSelect T="string" @bind-Value="context.Txn.Category" Dense="true" Margin="Margin.Dense" Underline="false">
                            @foreach (var c in Categories.For(context.Txn.TxnType)) { <MudSelectItem Value="@c.Name">@c.Name</MudSelectItem> }
                        </MudSelect>
                    </MudTd>
                    <MudTd Style="text-align:right" Class="@($"nowrap fw-600 {(context.Txn.IsIncome ? "pos" : "")}")">@(context.Txn.IsIncome ? "+" : "-")@Fmt.Inr(context.Txn.Amount)</MudTd>
                </RowTemplate>
            </MudTable>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseImport">Cancel</MudButton>
        @if (ImportPreview.Any())
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CommitImport" Disabled="Busy">@(Busy ? "Importing..." : $"Import {ImportPreview.Count(r => r.Include)}")</MudButton>
        }
    </DialogActions>
</MudDialog>

<!-- BUDGET -->
<MudDialog @bind-Visible="BudgetOpen" Options="DialogXs">
    <TitleContent><div class="dialog-title">Monthly budget</div></TitleContent>
    <DialogContent>
        <MudSelect T="string" @bind-Value="NewBudget.Category" Label="Category" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
            @foreach (var c in Categories.Expense) { <MudSelectItem Value="@c.Name">@c.Name</MudSelectItem> }
        </MudSelect>
        <MudNumericField @bind-Value="NewBudget.MonthlyLimit" Label="Limit" Adornment="Adornment.Start" AdornmentText="@Fmt.Rupee" Format="N0" HideSpinButtons="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
        @if (!string.IsNullOrEmpty(NewBudget.Category))
        {
            var avg = AvgMonthlySpend(NewBudget.Category);
            if (avg > 0)
            {
                <div class="small muted-text mt-2">
                    You usually spend about @Fmt.Inr(avg) a month here.
                    <MudLink Typo="Typo.caption" OnClick="@(() => NewBudget.MonthlyLimit = Math.Round(avg * 0.9m / 100) * 100)">Use 10% less</MudLink>
                </div>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => BudgetOpen = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveBudget">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private class ImportRow { public Transaction Txn { get; set; } = new(); public bool Include { get; set; } = true; public bool Duplicate { get; set; } }

    private static readonly DialogOptions DialogSmall = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
    private static readonly DialogOptions DialogLarge = new() { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
    private static readonly DialogOptions DialogXs = new() { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseButton = true };

    private FinanceSnapshot? Snap;
    private List<Transaction> AllTxns = new();
    private List<Budget> Budgets = new();
    private List<ImportRow> ImportPreview = new();
    private Transaction Editing = new();
    private Budget NewBudget = new();
    private bool Loading = true, EditOpen, ImportOpen, BudgetOpen, Busy, Parsing, MakeRecurring;
    private string? ImportAccountId, Search, FilterCategory;
    private string FilterType = "All";
    private DateTime Month = Fmt.ThisMonth;

    // Month cache so heavy LINQ runs once per render
    private DateTime _cachedFor;
    private int _cachedVersion = -1, _version;
    private List<Transaction> _monthItems = new();
    private List<Transaction> _upcoming = new();

    private DateTime? EditDate { get => Editing.TxnDate; set => Editing.TxnDate = value ?? DateTime.Today; }
    private string DialogTitle => Editing.Id != null ? "Edit transaction" : Editing.RecurringId != null ? Editing.Description : "New transaction";

    // ---------- data shaping ----------
    private void EnsureMonth()
    {
        if (_cachedFor == Month && _cachedVersion == _version) return;
        _cachedFor = Month; _cachedVersion = _version;
        var real = AllTxns.Where(t => Fmt.MonthOf(t.TxnDate) == Month).ToList();
        var virt = VirtualFor(Month, real);
        var today = DateTime.Today;
        _upcoming = virt.Where(v => v.TxnDate > today).OrderBy(v => v.TxnDate).ToList();
        _monthItems = real.Where(t => !(t.RecurringId != null && t.Amount == 0)) // skipped markers
                          .Concat(virt.Where(v => v.TxnDate <= today))
                          .OrderByDescending(t => t.TxnDate).ToList();
    }

    private List<Transaction> VirtualFor(DateTime month, List<Transaction> real)
    {
        if (Snap == null || month > Fmt.ThisMonth) return new();
        var done = real.Where(t => t.RecurringId != null).Select(t => t.RecurringId).ToHashSet();
        return Snap.Recurring.Where(r => r.OccursIn(month) && !done.Contains(r.Id)).Select(r => new Transaction
        {
            Id = null!, RecurringId = r.Id, IsVirtual = true, UserId = r.UserId, TxnDate = r.DateIn(month),
            Description = r.Name, Amount = r.Amount, TxnType = r.Kind, Category = r.Category, PaymentMode = r.PaymentMode, AccountId = r.AccountId
        }).ToList();
    }

    private List<Transaction> MonthItems { get { EnsureMonth(); return _monthItems; } }
    private List<Transaction> Upcoming { get { EnsureMonth(); return _upcoming; } }

    private List<Transaction> ItemsIn(DateTime m)
    {
        if (m == Month) return MonthItems;
        var real = AllTxns.Where(t => Fmt.MonthOf(t.TxnDate) == m).ToList();
        var virt = VirtualFor(m, real).Where(v => v.TxnDate <= DateTime.Today);
        return real.Where(t => !(t.RecurringId != null && t.Amount == 0)).Concat(virt).ToList();
    }

    private decimal Spent => MonthItems.Where(t => t.IsSpend).Sum(t => t.Amount);
    private decimal Earned => MonthItems.Where(t => t.IsIncome).Sum(t => t.Amount);
    private decimal Invested => MonthItems.Where(t => t.IsInvestment).Sum(t => t.Amount);
    private decimal PrevSpent => ItemsIn(Month.AddMonths(-1)).Where(t => t.IsSpend).Sum(t => t.Amount);
    private decimal DailyAvg { get { var d = Month == Fmt.ThisMonth ? DateTime.Today.Day : DateTime.DaysInMonth(Month.Year, Month.Month); return d > 0 ? Spent / d : 0; } }

    private IEnumerable<Transaction> Filtered => MonthItems
        .Where(t => FilterType == "All" || t.TxnType == FilterType)
        .Where(t => string.IsNullOrEmpty(FilterCategory) || t.Category == FilterCategory)
        .Where(t => string.IsNullOrWhiteSpace(Search) || t.Description.Contains(Search, StringComparison.OrdinalIgnoreCase)
                    || (t.Notes ?? "").Contains(Search, StringComparison.OrdinalIgnoreCase) || t.Category.Contains(Search, StringComparison.OrdinalIgnoreCase));

    private List<(string Name, decimal Total)> ByCategory => MonthItems.Where(t => t.IsSpend).GroupBy(t => t.Category)
        .Select(g => (g.Key, g.Sum(t => t.Amount))).OrderByDescending(x => x.Item2).ToList();

    private decimal SpentIn(string c) => MonthItems.Where(t => t.IsExpense && t.Category == c).Sum(t => t.Amount);

    private decimal AvgMonthlySpend(string c)
    {
        var v = Enumerable.Range(1, 3).Select(i => ItemsIn(Fmt.ThisMonth.AddMonths(-i)).Where(t => t.IsExpense && t.Category == c).Sum(t => t.Amount)).Where(x => x > 0).ToList();
        return v.Any() ? v.Average() : 0;
    }

    private List<(DateTime Month, decimal Spent, decimal Earned)> Trend() => Enumerable.Range(0, 6).Select(i => Month.AddMonths(i - 5)).Select(m =>
    {
        var tx = ItemsIn(m);
        return (m, tx.Where(t => t.IsSpend).Sum(t => t.Amount), tx.Where(t => t.IsIncome).Sum(t => t.Amount));
    }).ToList();

    private List<string> Insights()
    {
        var list = new List<string>();
        var spent = Spent;
        if (spent == 0) return list;
        var cats = ByCategory;
        var top = cats.First();
        list.Add($"{top.Name} is your biggest spend: {Fmt.Inr(top.Total)} ({Fmt.Pct(Fmt.Ratio(top.Total, spent))}).");
        var prev = ItemsIn(Month.AddMonths(-1)).Where(t => t.IsSpend).GroupBy(t => t.Category).ToDictionary(g => g.Key, g => g.Sum(t => t.Amount));
        var jump = cats.Where(c => prev.TryGetValue(c.Name, out var p) && p > 500 && c.Total > p * 1.3m).OrderByDescending(c => c.Total - prev[c.Name]).FirstOrDefault();
        if (jump.Total > 0) list.Add($"{jump.Name} is up {Fmt.Inr(jump.Total - prev[jump.Name])} vs last month.");
        var oneOff = MonthItems.Where(t => t.IsSpend && t.RecurringId == null).OrderByDescending(t => t.Amount).FirstOrDefault();
        if (oneOff != null) list.Add($"Largest one-off: {oneOff.Description} ({Fmt.Inr(oneOff.Amount)}, {oneOff.TxnDate:dd MMM}).");
        var small = MonthItems.Where(t => t.IsSpend && t.Amount < 200).ToList();
        if (small.Count >= 15) list.Add($"{small.Count} small payments under {Fmt.Inr(200)} added up to {Fmt.Inr(small.Sum(t => t.Amount))}.");
        var weekend = MonthItems.Where(t => t.IsSpend && t.RecurringId == null && t.TxnDate.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday).Sum(t => t.Amount);
        if (weekend > spent * 0.4m) list.Add($"{Fmt.Pct(Fmt.Ratio(weekend, spent))} of spending happened on weekends.");
        return list;
    }

    private RenderFragment Row(Transaction t, bool upcoming) => __builder =>
    {
        var cat = Categories.Get(t.Category);
        <div class="list-row @(upcoming ? "upcoming" : "")" @onclick="@(() => OpenEdit(t))">
            <div class="brand-avatar" style="background:@(cat.Color)1f;color:@cat.Color"><MudIcon Icon="@cat.Icon" Size="Size.Small" /></div>
            <div class="flex-1 min-w-0">
                <div class="row-title">
                    @t.Description
                    @if (t.RecurringId != null) { <MudIcon Icon="@Icons.Material.Rounded.Autorenew" Size="Size.Small" Class="row-badge" Title="Recurring" /> }
                </div>
                <div class="row-sub">
                    @if (upcoming) { <span>Due @t.TxnDate.ToString("dd MMM") @Fmt.Dot </span> }
                    @t.Category @Fmt.Dot @t.PaymentMode
                    @if (AccountName(t.AccountId) is string acc) { <span> @Fmt.Dot @acc</span> }
                </div>
            </div>
            <div class="row-amount @(t.IsIncome ? "pos" : t.IsInvestment ? "inv" : "")">@(t.IsIncome ? "+" : "-")@Fmt.Inr(t.Amount)</div>
        </div>
    };

    private static string DayLabel(DateTime d) => d == DateTime.Today ? "Today" : d == DateTime.Today.AddDays(-1) ? "Yesterday" : d.ToString("ddd, dd MMM");
    private string? AccountName(string? id) => id == null ? null : Snap?.Accounts.FirstOrDefault(a => a.Id == id)?.DisplayName;
    private void ChangeMonth(int d) => Month = Month.AddMonths(d);
    private void Touch() => _version++;

    // ---------- load ----------
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var snapT = Engine.GetAsync();
            var since = Fmt.ThisMonth.AddMonths(-12).ToString("yyyy-MM-dd");
            var uid = Engine.UserId;
            var txT = Db.From<Transaction>().Where(x => x.UserId == uid).Filter("txn_date", Operator.GreaterThanOrEqual, since).Order("txn_date", Ordering.Descending).Get();
            await Task.WhenAll(snapT, txT);
            Snap = snapT.Result;
            AllTxns = txT.Result.Models;
            Budgets = Snap.Budgets.ToList();
        }
        catch (Exception ex) { Snackbar.Add($"Couldn't load transactions: {ex.Message}", Severity.Error); Snap ??= new FinanceSnapshot(); }
        finally { Loading = false; Touch(); }
    }

    // ---------- add / edit ----------
    private void OpenNew(string kind)
    {
        Editing = new Transaction { TxnType = kind, Category = Categories.DefaultFor(kind), TxnDate = Month == Fmt.ThisMonth ? DateTime.Today : Month };
        MakeRecurring = false;
        EditOpen = true;
    }

    private void OpenEdit(Transaction t)
    {
        Editing = new Transaction
        {
            Id = t.Id, UserId = t.UserId, TxnDate = t.TxnDate, Description = t.Description, Amount = t.Amount, TxnType = t.TxnType,
            Category = t.Category, PaymentMode = t.PaymentMode, AccountId = t.AccountId, Notes = t.Notes, RecurringId = t.RecurringId, IsVirtual = t.IsVirtual
        };
        MakeRecurring = false;
        EditOpen = true;
    }

    private void SetType(string k) { Editing.TxnType = k; Editing.Category = Categorize(Editing.Description, k); }

    private static string Categorize(string? desc, string kind) => kind switch
    {
        TxnKinds.Investment => Categories.AutoCategorizeInvestment(desc),
        TxnKinds.Income => Categories.AutoCategorize(desc, true),
        _ => Categories.AutoCategorize(desc, false)
    };

    private void AutoCat()
    {
        if (Editing.Id != null || Editing.RecurringId != null || string.IsNullOrWhiteSpace(Editing.Description)) return;
        var g = Categorize(Editing.Description, Editing.TxnType);
        if (g is not ("Other" or "Other Income")) Editing.Category = g;
    }

    private async Task Save(bool another)
    {
        if (Editing.Amount <= 0) { Snackbar.Add("Enter an amount.", Severity.Warning); return; }
        if (string.IsNullOrWhiteSpace(Editing.Description)) Editing.Description = Editing.Category;
        Busy = true;
        try
        {
            Editing.UserId = Engine.UserId!;
            if (MakeRecurring && Editing.Id == null)
            {
                var rule = new RecurringItem
                {
                    UserId = Editing.UserId, Name = Editing.Description, Amount = Editing.Amount, Kind = Editing.TxnType, Category = Editing.Category,
                    DayOfMonth = Editing.TxnDate.Day, StartMonth = Fmt.MonthOf(Editing.TxnDate), PaymentMode = Editing.PaymentMode, AccountId = Editing.AccountId,
                    IsEssential = Editing.IsExpense && Editing.Category is "Housing" or "EMI & Loans" or "Bills & Utilities" or "Groceries" or "Insurance" or "Education" or "Health"
                };
                await Db.From<RecurringItem>().Insert(rule);
                Snap = await Engine.GetAsync(force: true);
                Snackbar.Add("Added as recurring. It will appear every month.", Severity.Success);
                EditOpen = false;
                return;
            }

            if (Editing.Id == null)
            {
                var res = await Db.From<Transaction>().Insert(Editing);
                AllTxns.AddRange(res.Models);
            }
            else
            {
                await Db.From<Transaction>().Update(Editing);
                var i = AllTxns.FindIndex(t => t.Id == Editing.Id);
                if (i >= 0) AllTxns[i] = Editing;
            }
            Engine.Invalidate();
            Touch();
            BudgetAlert(Editing);
            Snackbar.Add("Saved", Severity.Success);
            if (another)
            {
                var k = Editing;
                Editing = new Transaction { TxnType = k.TxnType, TxnDate = k.TxnDate, PaymentMode = k.PaymentMode, AccountId = k.AccountId, Category = k.Category };
            }
            else EditOpen = false;
        }
        catch (Exception ex) { Snackbar.Add($"Couldn't save: {ex.Message}", Severity.Error); }
        finally { Busy = false; }
    }

    private async Task SkipRecurring()
    {
        Busy = true;
        try
        {
            var marker = new Transaction
            {
                UserId = Engine.UserId!, RecurringId = Editing.RecurringId, TxnDate = Editing.TxnDate, Description = Editing.Description,
                Amount = 0, TxnType = Editing.TxnType, Category = Editing.Category, PaymentMode = Editing.PaymentMode, Notes = "Skipped"
            };
            var res = await Db.From<Transaction>().Insert(marker);
            AllTxns.AddRange(res.Models);
            Touch();
            EditOpen = false;
            Snackbar.Add($"Skipped for {Editing.TxnDate:MMMM}", Severity.Info);
        }
        catch (Exception ex) { Snackbar.Add($"Couldn't skip: {ex.Message}", Severity.Error); }
        finally { Busy = false; }
    }

    private void BudgetAlert(Transaction t)
    {
        if (!t.IsExpense) return;
        var b = Budgets.FirstOrDefault(x => x.Category == t.Category);
        if (b == null || b.MonthlyLimit <= 0 || Fmt.MonthOf(t.TxnDate) != Month) return;
        var pct = Fmt.Ratio(SpentIn(t.Category), b.MonthlyLimit);
        if (pct >= 100) Snackbar.Add($"{t.Category} budget exceeded", Severity.Error);
        else if (pct >= 80) Snackbar.Add($"{t.Category} budget {Fmt.Pct(pct)} used", Severity.Warning);
    }

    private async Task DeleteEditing()
    {
        Busy = true;
        try
        {
            var id = Editing.Id;
            await Db.From<Transaction>().Where(x => x.Id == id).Delete();
            AllTxns.RemoveAll(t => t.Id == id);
            Engine.Invalidate();
            Touch();
            EditOpen = false;
            Snackbar.Add("Deleted", Severity.Info);
        }
        catch (Exception ex) { Snackbar.Add($"Couldn't delete: {ex.Message}", Severity.Error); }
        finally { Busy = false; }
    }

    // ---------- import ----------
    private async Task HandleImport(InputFileChangeEventArgs e)
    {
        Parsing = true;
        try
        {
            using var stream = e.File.OpenReadStream(10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;
            var parsed = StatementParser.Parse(ms, e.File.Name);
            if (!parsed.Any()) { Snackbar.Add("No transactions found in this file.", Severity.Warning); return; }
            var existing = AllTxns.Select(Key).ToHashSet();
            var isCard = ImportAccountId != null && Snap?.Accounts.FirstOrDefault(a => a.Id == ImportAccountId)?.IsCredit == true;
            ImportPreview = parsed.Select(t =>
            {
                t.AccountId = ImportAccountId;
                if (isCard) t.PaymentMode = "Credit Card";
                var dup = existing.Contains(Key(t));
                return new ImportRow { Txn = t, Duplicate = dup, Include = !dup };
            }).OrderByDescending(r => r.Txn.TxnDate).ToList();
        }
        catch (Exception ex) { Snackbar.Add($"Couldn't read statement: {ex.Message}", Severity.Error); }
        finally { Parsing = false; }
    }

    private static string Key(Transaction t) => $"{t.TxnDate:yyyyMMdd}|{t.Amount:F2}|{t.Description.Trim().ToLowerInvariant()}";

    private async Task CommitImport()
    {
        var rows = ImportPreview.Where(r => r.Include).Select(r => { r.Txn.UserId = Engine.UserId!; return r.Txn; }).ToList();
        if (!rows.Any()) return;
        Busy = true;
        try
        {
            foreach (var chunk in rows.Chunk(200))
                AllTxns.AddRange((await Db.From<Transaction>().Insert(chunk.ToList())).Models);
            Engine.Invalidate();
            Month = Fmt.MonthOf(rows.Max(t => t.TxnDate));
            Touch();
            Snackbar.Add($"Imported {rows.Count} transactions", Severity.Success);
            CloseImport();
        }
        catch (Exception ex) { Snackbar.Add($"Import failed: {ex.Message}", Severity.Error); }
        finally { Busy = false; }
    }

    private void CloseImport() { ImportOpen = false; ImportPreview.Clear(); ImportAccountId = null; }

    // ---------- export ----------
    private async Task Export(bool year)
    {
        var data = year
            ? Enumerable.Range(0, 12).SelectMany(i => ItemsIn(Fmt.ThisMonth.AddMonths(-i))).ToList()
            : MonthItems.ToList();
        if (!data.Any()) { Snackbar.Add("Nothing to export.", Severity.Info); return; }
        var csv = StatementParser.ToCsv(data, AccountName);
        await JS.InvokeVoidAsync("arthaDownload", year ? $"ArthaOne_{DateTime.Today:yyyyMMdd}.csv" : $"ArthaOne_{Month:yyyy_MM}.csv", csv, "text/csv;charset=utf-8");
    }

    // ---------- budgets ----------
    private void OpenBudget()
    {
        NewBudget = new Budget { Category = ByCategory.Select(c => c.Name).FirstOrDefault(n => Budgets.All(b => b.Category != n)) ?? "Food & Dining" };
        BudgetOpen = true;
    }

    private async Task SaveBudget()
    {
        if (string.IsNullOrEmpty(NewBudget.Category) || NewBudget.MonthlyLimit <= 0) { Snackbar.Add("Pick a category and limit.", Severity.Warning); return; }
        try
        {
            var ex = Budgets.FirstOrDefault(b => b.Category == NewBudget.Category);
            if (ex != null) { ex.MonthlyLimit = NewBudget.MonthlyLimit; await Db.From<Budget>().Update(ex); }
            else { NewBudget.UserId = Engine.UserId!; Budgets.AddRange((await Db.From<Budget>().Insert(NewBudget)).Models); }
            Engine.Invalidate();
            BudgetOpen = false;
        }
        catch (Exception e) { Snackbar.Add($"Couldn't save budget: {e.Message}", Severity.Error); }
    }

    private async Task DeleteBudget(Budget b)
    {
        try { await Db.From<Budget>().Where(x => x.Id == b.Id).Delete(); Budgets.Remove(b); Engine.Invalidate(); }
        catch (Exception e) { Snackbar.Add($"Couldn't remove: {e.Message}", Severity.Error); }
    }
}
